      },
      {
        "id": "eval",
        "type": "evaluate_agent",
        "params": {
          "episodes": 10
        }
      }
    ],
    "edges": [
      {
        "source": "env",
        "source_port": "out_1",
        "target": "agent",
        "target_port": "env"
      },
      {
        "source": "env",
        "source_port": "out_1",
        "target": "eval",
        "target_port": "env"
      },
      {
        "source": "agent",
        "source_port": "out_1",
        "target": "eval",
        "target_port": "policy"
      }
    ]
  }

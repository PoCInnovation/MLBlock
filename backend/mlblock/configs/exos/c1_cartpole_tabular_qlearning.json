{
  "name": "CartPole-v1 Tabular Q-learning",
  "description": "Apprentissage par renforcement tabulaire (Q-Learning) avec discrétisation des observations continues sur l'environnement Gymnasium CartPole-v1.",
  "graph": {
    "nodes": [
      {

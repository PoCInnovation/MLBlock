        "params": {
          "size": 32
        }
      },
      {
        "id": "flip",
        "type": "random_flip",
        "params": {
          "p": 0.5
        }
      },
      {
        "id": "norm",
        "type": "normalize",
        "params": {
          "mean": [0.4914, 0.4822, 0.4465],
          "std": [0.2023, 0.1994, 0.2010]
        }
      },
      {
        "id": "loader",
        "type": "data_loader",
        "params": {
          "batch_size": 32,
          "shuffle": true
        }
      },
      {
        "id": "conv1",
        "type": "conv2d_layer",
        "params": {
          "in_channels": 3,
          "out_channels": 32,
          "kernel_size": 3
        }
      },
      {
        "id": "relu1",
        "type": "relu_layer",
        "params": {}
      },
      {
        "id": "pool1",
        "type": "maxpool2d_layer",
        "params": {
          "kernel_size": 2
        }
      },
      {
        "id": "conv2",
        "type": "conv2d_layer",
        "params": {
          "in_channels": 32,
          "out_channels": 64,
          "kernel_size": 3
        }
      },
      {
        "id": "flat",
        "type": "flatten_layer",
        "params": {}
      },
      {
        "id": "fc",
        "type": "linear_layer",
        "params": {
          "in_features": 4096,
          "out_features": 10
        }
      },
      {
        "id": "loss",
        "type": "cross_entropy_loss",
        "params": {}
      },
      {
        "id": "optimizer",
        "type": "adam",
        "params": {
          "lr": 0.001
        }
      },
      {
        "id": "trainer",
        "type": "train_model",
        "params": {
          "epochs": 5
        }
      }
    ],
    "edges": [

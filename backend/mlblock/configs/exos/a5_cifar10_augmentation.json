{
  "name": "CIFAR-10 + augmentation",
  "description": "Entraînement CNN sur CIFAR-10 enrichi d'un pipeline d'augmentation de données en S1 (random_crop, random_flip, normalize).",
  "graph": {
    "nodes": [
      {
        "id": "dataset",
        "type": "load_torch_dataset",
        "params": {
          "name": "cifar10",
          "batch_size": 32,
          "split": "train"
        }
      },
      {

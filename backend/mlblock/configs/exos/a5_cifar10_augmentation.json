      },
      {
        "source": "norm",
        "source_port": "out_1",
        "target": "loader",
        "target_port": "in_1"
      },
      {
        "source": "loader",
        "source_port": "out_1",
        "target": "trainer",
        "target_port": "in_2"
      },
      {
        "source": "conv1",
        "source_port": "out_1",

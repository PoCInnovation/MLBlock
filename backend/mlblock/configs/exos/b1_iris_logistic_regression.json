        "type": "evaluate",
        "params": {
          "target_column": "target",
          "method": "accuracy"
        }
      }
    ],
    "edges": [
      {
        "source": "dataset",
        "source_port": "out_1",
        "target": "split",
        "target_port": "dataset"
      },
      {
        "source": "split",
        "source_port": "out_1",
        "target": "model",
        "target_port": "train_data"
      },
      {
        "source": "split",
        "source_port": "out_2",
        "target": "eval",
        "target_port": "test_data"
      },
      {
        "source": "model",

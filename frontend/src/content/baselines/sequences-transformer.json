  "difficulty": "difficile",
  "etapes": {
    "chargement": ["tokenize"],
    "traitement": ["build_vocab", "encode_text", "to_tensor", "embedding", "multihead_attention", "layernorm"]
  },
  "name": "Transformer from scratch",
  "nodes": [
